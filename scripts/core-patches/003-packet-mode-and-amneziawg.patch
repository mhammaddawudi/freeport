+    /// AmneziaWG's own client defaults: a few junk datagrams of 40-70
+    /// bytes straight before the handshake, no signature packets. The
+    /// shape that got through where plain WireGuard did not.
+    pub fn amnezia() -> Self {
+        Self {
+            jc: 4,
+            jc_before_hs: 4,
+            jmin: 40,
+            jmax: 70,
+            ..Self::off()
+        }
+    }
+
+    /// Applies AmneziaWG-style settings over this profile, one `Key = value`
+    /// per line or separated by `;`: Jc, Jmin, Jmax and I1-I5 as in an
+    /// AmneziaWG config. S1-S4 and H1-H4 are read but must stay at their
+    /// defaults (0 and 1-4): Cloudflare runs plain WireGuard and drops any
+    /// handshake with padding or other message types.
+    pub fn with_awg(mut self, spec: &str) -> Self {
+        for item in spec.split(|c| c == '\n' || c == ';') {
+            let Some((key, value)) = item.split_once('=') else { continue };
+            let (key, value) = (key.trim().to_ascii_lowercase(), value.trim());
+            let number = value.parse::<usize>().ok();
+            let signature = (!value.is_empty()).then(|| value.to_string());
+            match (key.as_str(), number) {
+                ("jc", Some(n)) => {
+                    self.jc = n;
+                    self.jc_before_hs = n;
+                    self.jc_after_i1 = 0;
+                }
+                ("jmin", Some(n)) => self.jmin = n,
+                ("jmax", Some(n)) => self.jmax = n,
+                ("i1", _) => self.i1 = signature,
+                ("i2", _) => self.i2 = signature,
+                ("i3", _) => self.i3 = signature,
+                ("i4", _) => self.i4 = signature,
+                ("i5", _) => self.i5 = signature,
+                ("s1" | "s2" | "s3" | "s4", Some(0)) => {}
+                ("h1", Some(1)) | ("h2", Some(2)) | ("h3", Some(3)) | ("h4", Some(4)) => {}
+                ("s1" | "s2" | "s3" | "s4" | "h1" | "h2" | "h3" | "h4", _) => {
+                    log::warn!("[-] {key} = {value} is ignored: cloudflare only answers plain wireguard headers");
+                }
+                _ => log::warn!("[-] unknown amneziawg setting '{key}'"),
+            }
+        }
+        if self.jmax < self.jmin {
+            self.jmax = self.jmin;
+        }
+        self
+    }
+
     pub fn is_enabled(&self) -> bool {
         self.jc > 0 || self.i1.is_some()
     }
 }
 
