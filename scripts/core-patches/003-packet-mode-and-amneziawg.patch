diff -ruN a/warp/src/packet.rs b/warp/src/packet.rs
--- a/warp/src/packet.rs	1970-01-01 03:30:00
+++ b/warp/src/packet.rs	2026-11-09 15:21:13
@@ -0,0 +1,234 @@
+//! Packet mode: the device's own IP packets go straight into WireGuard.
+//!
+//! Without it every app connection is ended twice on the phone — once by
+//! tun2socks, once by the userspace stack in front of WireGuard — and both
+//! recover from loss far worse than the phone's own TCP. With it the phone's
+//! kernel TCP runs end to end to the far server, the way the WireGuard and
+//! AmneziaWG apps carry traffic.
+//!
+//! The userspace stack stays up beside it for the app's own connections
+//! (health checks, speed tests, the SOCKS port). Replies are told apart by
+//! the connections that stack opened; everything else goes to the device.
+
+use std::collections::HashMap;
+use std::io;
+use std::net::IpAddr;
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd, RawFd};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use parking_lot::Mutex;
+use tokio::io::unix::AsyncFd;
+use tokio::sync::{mpsc, watch};
+
+use crate::error::{Result, WarpError};
+
+use crate::api::TunWaiter;
+
+/// TCP or UDP, our port, their address, their port.
+type Flow = (u8, u16, IpAddr, u16);
+
+const FLOW_IDLE: Duration = Duration::from_secs(10 * 60);
+const MAX_PACKET: usize = 65_535;
+const TCP: u8 = 6;
+const UDP: u8 = 17;
+
+/// The protocol and both ends of an IPv4 or IPv6 TCP/UDP packet.
+fn ends(pkt: &[u8]) -> Option<(u8, IpAddr, u16, IpAddr, u16)> {
+    let version = pkt.first()? >> 4;
+    let (proto, src, dst, offset) = match version {
+        4 if pkt.len() >= 20 => {
+            let ihl = usize::from(pkt[0] & 0x0f) * 4;
+            let src: [u8; 4] = pkt[12..16].try_into().ok()?;
+            let dst: [u8; 4] = pkt[16..20].try_into().ok()?;
+            (pkt[9], IpAddr::from(src), IpAddr::from(dst), ihl)
+        }
+        6 if pkt.len() >= 40 => {
+            let src: [u8; 16] = pkt[8..24].try_into().ok()?;
+            let dst: [u8; 16] = pkt[24..40].try_into().ok()?;
+            (pkt[6], IpAddr::from(src), IpAddr::from(dst), 40)
+        }
+        _ => return None,
+    };
+    if proto != TCP && proto != UDP {
+        return None;
+    }
+    let ports = pkt.get(offset..offset + 4)?;
+    let sport = u16::from_be_bytes([ports[0], ports[1]]);
+    let dport = u16::from_be_bytes([ports[2], ports[3]]);
+    Some((proto, src, sport, dst, dport))
+}
+
+/// The connections the userspace stack opened, so their replies reach it.
+#[derive(Default)]
+struct Flows(Mutex<HashMap<Flow, Instant>>);
+
+impl Flows {
+    fn opened(&self, pkt: &[u8]) {
+        let Some((proto, _, sport, dst, dport)) = ends(pkt) else { return };
+        let mut flows = self.0.lock();
+        if flows.len() > 4_096 {
+            flows.retain(|_, seen| seen.elapsed() < FLOW_IDLE);
+        }
+        flows.insert((proto, sport, dst, dport), Instant::now());
+    }
+
+    fn owns_reply(&self, pkt: &[u8]) -> bool {
+        let Some((proto, src, sport, _, dport)) = ends(pkt) else { return false };
+        match self.0.lock().get_mut(&(proto, dport, src, sport)) {
+            Some(seen) => {
+                *seen = Instant::now();
+                true
+            }
+            None => false,
+        }
+    }
+}
+
+struct Tun(AsyncFd<OwnedFd>);
+
+impl Tun {
+    fn adopt(fd: RawFd) -> io::Result<Tun> {
+        // Ours from here: the app passed a duplicate and keeps its own.
+        let owned = unsafe { OwnedFd::from_raw_fd(fd) };
+        let flags = unsafe { libc::fcntl(owned.as_raw_fd(), libc::F_GETFL) };
+        if flags < 0 || unsafe { libc::fcntl(owned.as_raw_fd(), libc::F_SETFL, flags | libc::O_NONBLOCK) } < 0 {
+            return Err(io::Error::last_os_error());
+        }
+        Ok(Tun(AsyncFd::new(owned)?))
+    }
+
+    async fn read(&self, buf: &mut [u8]) -> io::Result<usize> {
+        loop {
+            let mut ready = self.0.readable().await?;
+            let done = ready.try_io(|fd| {
+                let n = unsafe { libc::read(fd.as_raw_fd(), buf.as_mut_ptr().cast(), buf.len()) };
+                if n < 0 { Err(io::Error::last_os_error()) } else { Ok(n as usize) }
+            });
+            if let Ok(result) = done {
+                return result;
+            }
+        }
+    }
+
+    async fn write(&self, pkt: &[u8]) -> io::Result<()> {
+        loop {
+            let mut ready = self.0.writable().await?;
+            let done = ready.try_io(|fd| {
+                let n = unsafe { libc::write(fd.as_raw_fd(), pkt.as_ptr().cast(), pkt.len()) };
+                if n < 0 { Err(io::Error::last_os_error()) } else { Ok(()) }
+            });
+            if let Ok(result) = done {
+                return result;
+            }
+        }
+    }
+}
+
+/// Moves packets between WireGuard, the userspace stack and, once the app
+/// hands it over, the device. Runs until one side closes.
+pub async fn route(
+    mut from_wg: mpsc::Receiver<Vec<u8>>,
+    to_wg: mpsc::Sender<Vec<u8>>,
+    to_stack: mpsc::Sender<Vec<u8>>,
+    mut from_stack: mpsc::Receiver<Vec<u8>>,
+    mut waiter: TunWaiter,
+) -> Result<()> {
+    let flows = Arc::new(Flows::default());
+    let (tun_tx, tun_rx) = watch::channel::<Option<Arc<Tun>>>(None);
+
+    // The app's own connections, out through the tunnel.
+    let stack_flows = flows.clone();
+    let stack_wg = to_wg.clone();
+    let outbound = async move {
+        while let Some(pkt) = from_stack.recv().await {
+            stack_flows.opened(&pkt);
+            if stack_wg.send(pkt).await.is_err() {
+                break;
+            }
+        }
+    };
+
+    // Replies: the stack's to the stack, everything else to the device.
+    let inbound = async move {
+        while let Some(pkt) = from_wg.recv().await {
+            let device = tun_rx.borrow().clone();
+            match device {
+                Some(tun) if !flows.owns_reply(&pkt) => {
+                    if let Err(e) = tun.write(&pkt).await {
+                        log::debug!("[packet] device write failed: {e}");
+                    }
+                }
+                _ => {
+                    if to_stack.send(pkt).await.is_err() {
+                        break;
+                    }
+                }
+            }
+        }
+    };
+
+    // The device's packets, straight in, once the app has handed it over.
+    let device = async move {
+        let fd = loop {
+            if let Some(fd) = *waiter.borrow_and_update() {
+                break fd;
+            }
+            if waiter.changed().await.is_err() {
+                return Ok::<(), WarpError>(());
+            }
+        };
+        let tun = Arc::new(Tun::adopt(fd).map_err(|e| WarpError::Other(format!("the device tunnel: {e}")))?);
+        let _ = tun_tx.send(Some(tun.clone()));
+        log::info!("[+] packet mode: the device's traffic goes straight into wireguard");
+        let mut buf = vec![0u8; MAX_PACKET];
+        loop {
+            let n = tun.read(&mut buf).await.map_err(|e| WarpError::Other(format!("the device tunnel: {e}")))?;
+            if n == 0 {
+                return Ok(());
+            }
+            if to_wg.send(buf[..n].to_vec()).await.is_err() {
+                return Ok(());
+            }
+        }
+    };
+
+    tokio::select! {
+        _ = outbound => Ok(()),
+        _ = inbound => Ok(()),
+        result = device => result,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn udp4(src: [u8; 4], sport: u16, dst: [u8; 4], dport: u16) -> Vec<u8> {
+        let mut pkt = vec![0u8; 28];
+        pkt[0] = 0x45;
+        pkt[9] = UDP;
+        pkt[12..16].copy_from_slice(&src);
+        pkt[16..20].copy_from_slice(&dst);
+        pkt[20..22].copy_from_slice(&sport.to_be_bytes());
+        pkt[22..24].copy_from_slice(&dport.to_be_bytes());
+        pkt
+    }
+
+    #[test]
+    fn replies_to_the_stacks_connections_go_back_to_it() {
+        let flows = Flows::default();
+        flows.opened(&udp4([172, 16, 0, 2], 40_000, [1, 1, 1, 1], 53));
+        assert!(flows.owns_reply(&udp4([1, 1, 1, 1], 53, [172, 16, 0, 2], 40_000)));
+        // Same server, another port: a device connection.
+        assert!(!flows.owns_reply(&udp4([1, 1, 1, 1], 53, [172, 16, 0, 2], 40_001)));
+    }
+
+    #[test]
+    fn short_or_foreign_packets_are_nobodys() {
+        assert!(ends(&[0x45, 0, 0]).is_none());
+        let mut icmp = udp4([1, 1, 1, 1], 0, [172, 16, 0, 2], 0);
+        icmp[9] = 1;
+        assert!(ends(&icmp).is_none());
+    }
+}
