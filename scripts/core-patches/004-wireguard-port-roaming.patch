+/// How long without a valid packet before the tunnel moves to a new local port.
+fn wg_roam_after() -> Duration {
+    let secs = std::env::var("WARP_WG_ROAM_SECS")
+        .ok()
+        .and_then(|v| v.parse::<u64>().ok())
+        .filter(|&v| v > 0)
+        .unwrap_or(6);
+    Duration::from_secs(secs)
+}
+
