+const QUIC_PORT: u16 = 443;
+
+/// Whether QUIC (UDP to 443) is dropped, from `WARP_BLOCK_QUIC=1`. Inside a tunnel QUIC
+/// stalls on every loss, and on an HTTP/2 carrier it rides TCP twice over; apps such as
+/// Instagram then wait on it rather than use TCP. Dropped, they fall back to TCP at once.
+fn quic_blocked() -> bool {
+    static BLOCKED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *BLOCKED.get_or_init(|| {
+        let on = std::env::var("WARP_BLOCK_QUIC")
+            .map(|v| matches!(v.trim(), "1" | "true" | "on" | "yes"))
+            .unwrap_or(false);
+        if on {
+            log::info!("[*] quic is dropped, so apps use tcp through the tunnel");
+        }
+        on
+    })
+}
+
