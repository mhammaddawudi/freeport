+/// How the netstack paces what it sends, from `WARP_TCP_CC` (`none`, `reno` or `cubic`).
+///
+/// `none` is the default. Measured over WireGuard on an Iranian line (round trip about 400 ms),
+/// smoltcp's cubic cut uploads from about 1.1 MB/s to about 250 KB/s and did nothing for downloads,
+/// whose pace the far end sets. The other choices stay for trying on other lines.
+fn tcp_congestion_control() -> tcp::CongestionControl {
+    static CHOICE: std::sync::OnceLock<tcp::CongestionControl> = std::sync::OnceLock::new();
+    *CHOICE.get_or_init(|| {
+        match std::env::var("WARP_TCP_CC").unwrap_or_default().trim().to_ascii_lowercase().as_str() {
+            "reno" => tcp::CongestionControl::Reno,
+            "cubic" => tcp::CongestionControl::Cubic,
+            _ => tcp::CongestionControl::None,
+        }
+    })
+}
+
 fn smol_duration(duration: std::time::Duration) -> smoltcp::time::Duration {
     smoltcp::time::Duration::from_millis(duration.as_millis().min(u64::MAX as u128) as u64)
 }
@@ -664,6 +680,7 @@ fn handle_cmd(s: &mut NetStack, cmd: Cmd) {
             let tx_buf = tcp::SocketBuffer::new(vec![0u8; tcp_tx_buf()]);
             let mut socket = tcp::Socket::new(rx_buf, tx_buf);
             socket.set_nagle_enabled(false);
+            socket.set_congestion_control(tcp_congestion_control());
             let keepalive = s.tcp_limits.keepalive;
             socket.set_keep_alive(Some(smol_duration(keepalive)));
             socket.set_timeout(Some(smol_duration(keepalive.saturating_mul(3))));
