{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Freeport",
  "version": "1.0.0",
  "identifier": "io.github.mhammaddawudi.freeport",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Freeport",
        "width": 440,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#04040B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis"],
    "category": "Utility",
    "shortDescription": "Freeport VPN",
    "longDescription": "Freeport: WARP over MASQUE and WireGuard, with region unlock through Psiphon.",
    "copyright": "GPL-3.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "11.0" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["English", "Farsi"] }
    }
  }
}
