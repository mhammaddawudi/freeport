    <!-- Region unlock -->
    <string name="region_title">لوکیشن خروجی</string>
    <string name="region_unlock">رفع محدودیت منطقه</string>
    <string name="region_unlock_desc">برای چت‌جی‌پی‌تی، کلش آف کلنز و موزیک اینستاگرام. از طریق سایفون از خارج خارج می‌شود؛ اتصال بیشتر طول می‌کشد.</string>
    <string name="region_any">سریع‌ترین</string>
    <string name="region_checking">در حال بررسی…</string>
    <string name="region_not_connected">بعد از اتصال نمایش داده می‌شود</string>
    <string name="region_warning">سایت‌ها شما را در ایران می‌بینند، برای همین چت‌جی‌پی‌تی، بازی‌هایی مثل کلش آف کلنز و بعضی موزیک‌های اینستاگرام کار نمی‌کنند. «رفع محدودیت منطقه» را روشن کنید.</string>
    <string name="region_warning_unlock_failed">رفع محدودیت منطقه این بار سروری پیدا نکرد و سایت‌ها هنوز ایران را می‌بینند. در اتصال بعدی دوباره تلاش می‌کند.</string>
    <string name="region_ok">سایت‌ها این کشور را می‌بینند. برنامه‌های دارای محدودیت منطقه باید کار کنند.</string>
